rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // DAVETASYON — SaaS Veri Modeli & Kuralları
    // ===============================================================
    //
    // Collection: events
    //   Document ID: auto-generated (eventId)
    //   Fields: hostId, title, templateId, aiContext, venue, createdAt
    //   Subcollection: events/{eventId}/rsvps    — misafir katılım yanıtları
    //   Subcollection: events/{eventId}/capsules — geleceğe bırakılan zaman kapsülleri
    //
    // Collection: users
    //   Fields: email, role, createdAt
    //
    // Collection: orders
    //   Sipariş talepleri — herkes oluşturabilir (boyut sınırlı), sadece admin okur/yönetir
    //
    // ===============================================================

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(hostId) {
      return isAuthenticated() && request.auth.uid == hostId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "zamankatilii@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    function isValidEvent(data) {
      return data.keys().hasAll(['hostId', 'title', 'templateId', 'createdAt']) &&
             data.hostId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.templateId is string && data.templateId.size() > 0 && data.templateId.size() <= 50 &&
             data.createdAt is timestamp;
    }

    function isValidRSVP(data) {
      return data.keys().hasAll(['name', 'status', 'count', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.status in ['yes', 'no'] &&
             data.count is number && data.count >= 1 && data.count <= 10 &&
             data.createdAt is timestamp &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    function isValidCapsule(data) {
      return data.keys().hasAll(['name', 'message', 'createdAt']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.createdAt is timestamp &&
             (!('unlocksAt' in data) || data.unlocksAt is timestamp);
    }

    function isValidOrder(data) {
      return data.keys().hasOnly(['names', 'eventType', 'date', 'time', 'venueName',
                                  'address', 'mapLink', 'concept', 'invitationText',
                                  'notes', 'music', 'wantsRSVP', 'wantsAI',
                                  'contact', 'language', 'initialConcept',
                                  'status', 'createdAt']) &&
             data.keys().hasAll(['names', 'eventType', 'contact', 'status', 'createdAt']) &&
             data.names is string && data.names.size() > 0 && data.names.size() <= 200 &&
             data.eventType is string && data.eventType.size() > 0 && data.eventType.size() <= 100 &&
             data.contact is string && data.contact.size() > 0 && data.contact.size() <= 120 &&
             data.status == 'new' &&
             data.createdAt is timestamp &&
             (!('invitationText' in data) || (data.invitationText is string && data.invitationText.size() <= 2000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('venueName' in data) || (data.venueName is string && data.venueName.size() <= 200)) &&
             (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
             (!('mapLink' in data) || (data.mapLink is string && data.mapLink.size() <= 500)) &&
             (!('concept' in data) || (data.concept is string && data.concept.size() <= 200)) &&
             (!('music' in data) || (data.music is string && data.music.size() <= 200)) &&
             (!('date' in data) || (data.date is string && data.date.size() <= 30)) &&
             (!('time' in data) || (data.time is string && data.time.size() <= 30)) &&
             (!('wantsRSVP' in data) || data.wantsRSVP is bool) &&
             (!('wantsAI' in data) || data.wantsAI is bool) &&
             (!('language' in data) || data.language in ['tr', 'en']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /events/{eventId} {
      // Anyone can read event details (guests need to see the invitation)
      allow read: if true;
      
      // Only authenticated users can create events, and hostId must match their UID
      allow create: if isAuthenticated() && isValidEvent(request.resource.data);
      
      // Only the host (or admin) can update/delete their event
      allow update, delete: if isOwner(resource.data.hostId) || isAdmin();

      // --- RSVPs Subcollection ---
      match /rsvps/{rsvpId} {
        // Guests (unauthenticated) can submit an RSVP
        allow create: if exists(/databases/$(database)/documents/events/$(eventId)) && isValidRSVP(request.resource.data);
        
        // Only the Host of the *parent event* or an admin can read the RSVPs
        allow read: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid);
        
        // Host or admin can delete/update
        allow update, delete: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid);
      }

      // --- Capsules Subcollection (zaman kapsülleri) ---
      match /capsules/{capsuleId} {
        // Guests can seal a capsule — message is size-limited, event must exist
        allow create: if exists(/databases/$(database)/documents/events/$(eventId)) && isValidCapsule(request.resource.data);
        
        // Only the host of the parent event (or admin) can read the sealed capsules
        allow read: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/events/$(eventId)).data.hostId == request.auth.uid);
        
        // Capsules are write-once — nobody edits or deletes them
        allow update, delete: if false;
      }
    }

    // --- Orders: public create (size-limited), admin read/manage only ---
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId && 
                    request.resource.data.keys().hasOnly(['email', 'role', 'createdAt']) && 
                    request.resource.data.role == 'user';
      allow update: if isAdmin();
    }
  }
}
